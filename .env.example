# ==============================================================================
# CENTRAL SOFTWARE COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (production, staging, development)
ENVIRONMENT=production
PROJECT_NAME="Central Software Command Center"
VERSION=1.0.0

# Security & Session Secrets (MUST be generated using: openssl rand -hex 32)
SECRET_KEY=command-center-super-secure-production-secret-key-389104810283
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Docker, or SQLite for local dev)
POSTGRES_USER=commandcenter
POSTGRES_PASSWORD=ChangeMeSecurePass123!
POSTGRES_DB=commandcenter
DATABASE_URL=postgresql+asyncpg://commandcenter:ChangeMeSecurePass123!@postgres:5432/commandcenter

# In-Memory Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Asymmetric License Authority (Ed25519 Private Key in PEM format - Optional if auto-generated)
# LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Outgoing Alerts & Integrations
DEFAULT_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/X00
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@command-center.local
SMTP_PASSWORD=ChangeMeSmtpPass!

# Synthetic Monitoring Configuration
MONITOR_INTERVAL_SECONDS=60
DEFAULT_MONITOR_TIMEOUT_SECONDS=10
